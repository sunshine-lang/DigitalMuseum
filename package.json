{
  "name": "digital-museum-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:phase0": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite --port 3001",
    "build": "bash scripts/build-verified.sh",
    "build:local": "bash scripts/sites-env.sh -- node_modules/.bin/vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:local": "npm run build:local && node --test tests/rendered-html.test.mjs && npm run test:export",
    "test:export": "node --experimental-strip-types --test tests/exhibition-export.test.mts",
    "test:e2e": "node tests/e2e/preflight.mjs && playwright test",
    "test:backend": "cd backend && UV_CACHE_DIR=../.sites-runtime/uv-cache uv run ruff check . && UV_CACHE_DIR=../.sites-runtime/uv-cache uv run pytest",
    "backend:sync": "cd backend && UV_CACHE_DIR=../.sites-runtime/uv-cache uv sync --python 3.11",
    "backend:dev": "cd backend && UV_CACHE_DIR=../.sites-runtime/uv-cache uv run uvicorn app.main:app --host 127.0.0.1 --port 8010 --reload",
    "typecheck": "tsc --noEmit",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9",
    "eslint-config-next": "16.2.6",
    "next": "16.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "Digital Museum · AI 人生档案馆"
}
