# Phase 0 local backend. Built-in defaults already use this repository's data/
# directory. Only uncomment absolute paths when you intentionally relocate data.
# DIGITAL_MUSEUM_DATABASE_URL=sqlite:////absolute/path/to/digital_museum.db
# DIGITAL_MUSEUM_UPLOAD_DIR=/absolute/path/to/uploads
# DIGITAL_MUSEUM_MAX_UPLOAD_BYTES=2097152

# Browser-visible local API location. Do not put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_DIGITAL_MUSEUM_API_URL=http://127.0.0.1:8010
